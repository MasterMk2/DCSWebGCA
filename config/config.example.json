{
  "server": {
    "port": 8080,
    "bind": "0.0.0.0",
    "broadcastIntervalMs": 200
  },

  "dcssb": {
    "_comment": "DCSServerBot RestAPI. Runway geometry is pulled from DCS itself through it; set enabled=false to rely purely on the static runways below.",
    "enabled": false,
    "baseUrl": "http://127.0.0.1:9876",
    "prefix": "/stats",
    "apiKey": "",
    "timeoutMs": 45000,
    "requestSpacingMs": 1500,
    "refreshOnMissionChange": true
  },

  "auth": {
    "_comment": "Set token to require ?token=... (or an Authorization: Bearer header) on /api/* and /ws. Empty = no auth.",
    "token": ""
  },

  "gca": {
    "staleAfterSec": 15,
    "glidepathDeg": 3.0,
    "azToleranceDeg": 0.8,
    "gsToleranceDeg": 0.4,
    "talkdownIntervalSec": 15,
    "talkdownMaxRangeNm": 12,
    "_phrases": "optional talk-down phrase overrides; placeholders: {callsign} {range} {side} {other} {heading} {dir} {intensity} {altitude} {verb}",
    "phrases": {
      "intro": "{callsign}, {range} miles from touchdown",
      "onCourse": "on course",
      "slightlyOffCourse": "slightly {side} of course, correct {other}",
      "offCourse": "{intensity}{side} of course, turn heading {heading}",
      "reportAltitude": "report altitude",
      "onGlidepath": "on glidepath",
      "offGlidepathHigh": "{intensity}high, descend and maintain {altitude} feet",
      "offGlidepathLow": "{intensity}low, climb and maintain {altitude} feet",
      "overThreshold": "over threshold, check runway in sight",
      "oneMile": "one mile, runway should be in sight"
    }
  },

  "sources": [
    {
      "id": "server1",
      "name": "DCS Server 1",
      "tacview": {
        "host": "127.0.0.1",
        "port": 42674,
        "password": "",
        "reconnectDelayMs": 5000,
        "clientName": "DCSWebGCA"
      },
      "_dcssbServerName": "name of this server in DCSServerBot's servers.yaml",
      "dcssbServerName": null,
      "_runways": "optional hand-written runways; they are merged in front of whatever is discovered from DCS",
      "runways": [
        {
          "id": "Nellis 21L",
          "threshold": { "lat": 36.2377, "lon": -115.0345, "altFt": 1870 },
          "headingDeg": 210,
          "glidepathDeg": 3.0,
          "lengthNm": 1.2
        }
      ],
      "defaultRunway": "Nellis 21L"
    }
  ]
}
